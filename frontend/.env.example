# AegisGrid ICS Frontend Environment Variables
# In production on Vercel, set VITE_API_URL to your Render web service URL.
# Examples:
#   VITE_API_URL=https://aegisgrid-backend.onrender.com
#   VITE_API_URL=https://ciphergrid-backend.onrender.com
#
# In local development, leave this empty to use the Vite dev proxy (http://127.0.0.1:5000).
VITE_API_URL=
